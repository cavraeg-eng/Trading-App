# Trading App environment template
# Copy this file to .env and replace placeholders with your local values.
# Keep .env files private; never commit real API tokens, account IDs, or passwords.

# ============================================
# Runtime mode and core app settings
# ============================================
TRADING_MODE=paper
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
INITIAL_CAPITAL=10000
MAX_POSITIONS=3
LEVERAGE=1

# ============================================
# Exchange API keys (optional for paper/local dev)
# ============================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true

# Broker credentials are entered through the Settings UI and are not required here.
# If you add broker-specific env support later, use placeholder values only.
# OANDA example placeholders: api token and account ID must stay out of git.
OANDA_API_TOKEN=your_oanda_api_token_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_ENVIRONMENT=paper

# ============================================
# Market data configuration
# ============================================
GOLD_API_KEY=your_goldapi_key_here
COINGECKO_API_KEY=your_coingecko_api_key_here
USE_SPOT_PRICES=true
XAU_SOURCE_POLICY=spot_preferred
ENABLE_COINGECKO_FALLBACK=true
COINGECKO_COOLDOWN_SECONDS=180
ENABLE_DATA_HEALTH_MONITORING=true
METALS_LIVE_ENABLED=false
GOLD_API_FREE_ENABLED=true
SWISSQUOTE_XAU_ENABLED=true
YF_MAX_CONCURRENT=2
YF_MAX_RETRIES=3
SPOT_CACHE_TTL_SCALP=20
SPOT_CACHE_TTL_SWING=60
OHLCV_CACHE_TTL_INTRADAY=5
OHLCV_CACHE_TTL_DAILY=300

# ============================================
# Risk management
# ============================================
MAX_DAILY_DRAWDOWN=0.05
MAX_POSITION_SIZE=0.3
MAX_TOTAL_EXPOSURE=0.8
RISK_PER_TRADE=0.02
VOLATILITY_TARGET=0.15

# ============================================
# AI prediction quality gates
# ============================================
PREDICTION_MIN_ACTIONABLE_CONFIDENCE=62
PREDICTION_STALE_DATA_SECONDS=900
PREDICTION_MAX_SPREAD_BPS=8
PREDICTION_MIN_RISK_REWARD=1.35
PREDICTION_VOLATILITY_SPIKE_ATR_PCT=2.5

# ============================================
# Data storage
# ============================================
DATA_DIR=./data
DB_PATH=./data/trading.db
TRADING_BOT_DB_PATH=./data/trading_bot.db
PARQUET_PATH=./data/parquet

# Redis is optional for local development and used by Docker/live workflows.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# Model configuration
# ============================================
MODEL_TYPE=PPO
MODEL_PATH=./models
TIMESTEPS=100000
LEARNING_RATE=0.0003
BATCH_SIZE=64

# ============================================
# Notifications (optional)
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ============================================
# Logging and monitoring
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/trading_bot.log
DASHBOARD_PORT=8501
METRICS_PORT=9090

# ============================================
# Frontend / API development
# ============================================
# Vite proxies /api to http://localhost:8010 in frontend/vite.config.ts.
BACKEND_API_URL=http://localhost:8010
FRONTEND_DEV_URL=http://localhost:5173
