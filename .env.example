# Trading Bot Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# EXCHANGE API KEYS (Binance)
# ============================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true

# ============================================
# MARKET DATA CONFIGURATION
# ============================================
# GoldAPI.io API key for accurate XAU/USD spot prices (optional but recommended)
# Get free API key at: https://www.goldapi.io/
GOLD_API_KEY=your_goldapi_key_here

# Use spot price APIs for XAU/USD instead of futures (default: true)
# Set to false to use COMEX futures (GC=F) instead of spot gold
USE_SPOT_PRICES=true

# ============================================
# TRADING CONFIGURATION
# ============================================
TRADING_MODE=paper  # Options: paper, live
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h
INITIAL_CAPITAL=10000
MAX_POSITIONS=3
LEVERAGE=1  # Spot trading = 1, Futures can be higher

# ============================================
# RISK MANAGEMENT
# ============================================
MAX_DAILY_DRAWDOWN=0.05  # 5% max daily drawdown
MAX_POSITION_SIZE=0.3    # Max 30% of capital per position
MAX_TOTAL_EXPOSURE=0.8   # Max 80% total exposure
RISK_PER_TRADE=0.02      # Risk 2% per trade
VOLATILITY_TARGET=0.15   # 15% annualized volatility target

# ============================================
# DATA STORAGE
# ============================================
DATA_DIR=./data
DB_PATH=./data/trading.db
PARQUET_PATH=./data/parquet

# Redis (optional, for live trading)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# MODEL CONFIGURATION
# ============================================
MODEL_TYPE=PPO  # Options: PPO, SAC
MODEL_PATH=./models
TIMESTEPS=100000
LEARNING_RATE=0.0003
BATCH_SIZE=64

# ============================================
# NOTIFICATIONS
# ============================================
# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Discord
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/trading_bot.log

# ============================================
# MONITORING
# ============================================
DASHBOARD_PORT=8501
METRICS_PORT=9090
